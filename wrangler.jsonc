{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "alcohol-label-verify",
  "main": "src/index.ts",

  // The bundled demonstration corpus. `testdata/` ships as static assets so the
  // batch endpoint can read the 26 submissions through the ASSETS binding
  // without a separate seeding step. `run_worker_first` keeps the Worker in
  // control of every route — assets are reachable only via the binding, never
  // served directly — so the corpus is not a public directory listing.
  "assets": {
    "directory": "./testdata",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Pinned deliberately. A floating runtime date changes behaviour underneath a
  // recorded audit trail, for the same reason D29 refuses a floating model alias.
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Structured logs. Payload-free by policy (D20) — identifiers, classifications
  // and timings only, never label artwork or application values.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Non-secret configuration. Secrets are set with `wrangler secret put NAME`
  // and never appear here or in the repository (§9.3).
  "vars": {
    "ENVIRONMENT": "development",

    // Model identity must be fully qualified. The service refuses to start on a
    // floating alias such as "-latest" (D29): a mutable identifier silently
    // invalidates every audit record that cites it.
    "MODEL_PROVIDER": "workers-ai",
    // Fully qualified. Candidates for the corpus evaluation (test-plan §18.2):
    //   @cf/meta/llama-4-scout-17b-16e-instruct    natively multimodal, tool calling
    //   @cf/mistralai/mistral-small-3.1-24b-instruct  strong vision, 128k context
    //   @cf/moondream/moondream3.1-9B-A2B          advertises OCR + structured output
    // Which reads a 4.5pt warning statement best is a measurement, not an opinion.
    "MODEL_ID": "@cf/meta/llama-4-scout-17b-16e-instruct",

    // Intake limits, enforced server-side regardless of client checks (§9.3).
    "MAX_UPLOAD_BYTES": "10485760",
    "MAX_PAGE_COUNT": "8",
    "MAX_PIXELS": "40000000",
    "MAX_BATCH_ITEMS": "300",

    // Rasterisation target. Recorded in the audit record, because an UNREADABLE
    // verdict may be an artefact of resolution rather than of the artwork (B-Q4).
    "RASTER_DPI": "300",

    // Extraction concurrency across a batch. Governed by the provider's rate
    // limit, not by platform capacity (batch design §6.1).
    "EXTRACT_CONCURRENCY": "5"
  },

  // Transient content: submission PDFs and rasterised regions, held for the
  // life of a job and purged on completion (B-D10). The durable record lives
  // in D1 and keeps only the digest.
  "r2_buckets": [{ "binding": "STAGING", "bucket_name": "alcohol-label-verify-staging" }],

  // The durable record: jobs, submissions, extractions, verdicts, and an
  // append-only hash-chained transaction history (D32).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alcohol-label-verify",
      "database_id": "ac8a691b-3b4b-4518-9539-54fe81203529"
    }
  ],

  // On-platform inference. No separate credential: the binding carries auth,
  // which is why /health does not require MODEL_API_KEY for this provider.
  "ai": { "binding": "AI" },

  // Server-side rasterisation for batch. The interactive path conditions in the
  // client instead (§9.1), so this is not on the single-review critical path.
  "browser": { "binding": "BROWSER" },

  "queues": {
    "producers": [{ "binding": "WORK", "queue": "alcohol-label-verify-work" }],
    "consumers": [
      {
        "queue": "alcohol-label-verify-work",
        // One submission per invocation. Batching would serialise the two
        // parallel extractions against the 6-connection cap (B-D4).
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "alcohol-label-verify-dlq"
      }
    ]
  },

  // One coordinator per job: ledger, progress, and client fan-out (§15.3).
  // It never fetches or extracts — its connection cap makes that a hard
  // boundary, not a preference (B-D12).
  "durable_objects": {
    "bindings": [{ "name": "JOB", "class_name": "JobCoordinator" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobCoordinator"] }]
}
